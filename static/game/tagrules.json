{
 "_doc": "REGRAS PELO TITULO DA SALA (dono 15/10: '@camp' etc. do PB antigo). Lido pelo netserver (tagrules.py: equipamento da partida + dano) e pelo cliente (pb.js PB.tagRule: inventario da sala, Montar personagem, troca do T). A 1a regra cujo 'match' (regex, sem maiuscula/minuscula) casa com o titulo vale; 'base' herda os campos de outra regra. Campos: deny_name = regex do nome da arma; deny_ext = extensao da arma (GrenadeLauncher...); chara_hp_max = personagem com HP maior fica de fora; parts_off = acessorios proibidos (Head = capacete, Facegear = mascara, Beret = boina); items_off = grupos de item de conta desligados (ItemID % 1000; 34 = Kit de velocidade C4); allow_slots = SO' armas destes slots (3 = arma branca): o resto vira a faca do jogador na partida. allow = SO' armas desta lista (classe, regex do nome e dano maximo = o da versao original; null = sem teto): o resto fica de fora.",
 "rules": [
  {
   "id": "79",
   "label": "@79",
   "match": "@79(?![0-9])",
   "desc": "@79 (modo faca): só arma branca -- sem arma de fogo, pistola, granada ou C4",
   "allow_slots": [
    3
   ]
  },
  {
   "id": "camp_sb",
   "base": "camp",
   "label": "@camp s/boina",
   "match": "@camp\\s*(s/|sem\\s*)boina",
   "desc": "@CAMP sem boina",
   "parts_off": [
    "Head",
    "Facegear",
    "Beret"
   ]
  },
  {
   "id": "camp_cb",
   "base": "camp",
   "label": "@camp c/boina",
   "match": "@camp\\s*(c/|com\\s*)boina",
   "desc": "@CAMP com boina"
  },
  {
   "id": "camp",
   "label": "@camp",
   "match": "@camp",
   "desc": "@CAMP: só armas clássicas (K-2, AK-47, M4A1, AUG A3, P90, L115A1, Desert Eagle...) no dano original; sem shotgun, sem dupla, sem F.C, sem armas novas; sem personagem de mais de 100 HP; sem capacete e máscara; sem Kit de velocidade C4",
   "deny_name": [
    "\\bdual\\b"
   ],
   "deny_ext": [
    "GrenadeLauncher",
    "ShotGunLauncher"
   ],
   "chara_hp_max": 100,
